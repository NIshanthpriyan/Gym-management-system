# ==============================================================================
# 🍃 MONGODB ATLAS / DATABASE ENVIRONMENT VARIABLES (EXAMPLE)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/gym_management_db?retryWrites=true&w=majority

PORT=8080
JWT_SECRET=GymManagementSystemSuperSecretKeyWithAtLeast256BitsOfEntropyWhichIsRequiredForHS256Algorithm
JWT_EXPIRATION_MS=86400000
